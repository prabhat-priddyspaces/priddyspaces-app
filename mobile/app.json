{
  "expo": {
    "name": "Priddyspaces",
    "slug": "priddyspaces",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F9FAFB"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is used to scan Space Access Pass QR codes for check-in.",
        "NSPhotoLibraryUsageDescription": "Photo library access is used to upload space listing photos."
      }
    },
    "android": {
      "permissions": ["CAMERA", "POST_NOTIFICATIONS", "READ_MEDIA_IMAGES"],
      "adaptiveIcon": {
        "backgroundColor": "#F9FAFB"
      }
    },
    "scheme": "priddyspaces"
  }
}
