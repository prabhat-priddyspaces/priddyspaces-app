# Set to true for local dev: 500 responses include detail + traceback
ENVIRONMENT=local
DEBUG=true
# When Postgres is from docker compose (port 5433 on host):
DATABASE_URL=postgresql+psycopg2://priddyspaces:priddyspaces@localhost:5433/priddyspaces
# Required for internal impersonation tokens and legacy local password auth;
# use e.g. openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=priddyspaces
JWT_AUDIENCE=priddyspaces
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_PAYMENT_PROVIDER=stripe
PAYMENT_METHOD_REQUIRED_FOR_REQUEST=true
PAYMENT_CHARGE_ON_APPROVAL=true
# Required in staging/production; use e.g. openssl rand -base64 32
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=
EMAIL_VERIFICATION_REQUIRED=true
API_RATE_LIMIT_ENABLED=true
SENSITIVE_RATE_LIMIT_PER_MINUTE=600
WEBHOOK_RATE_LIMIT_PER_MINUTE=1200

# Clerk is the production identity provider for web, mobile, and backend API auth.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWKS_URL=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

S3_BUCKET=
S3_REGION=
S3_PUBLIC_BASE_URL=
