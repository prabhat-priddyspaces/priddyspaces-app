    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.24",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^24.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
